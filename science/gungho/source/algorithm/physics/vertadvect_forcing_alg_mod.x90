!-------------------------------------------------------------------------------
!> @brief Calculate advection tendencies arising from a specified vertical
!>        velocity profile
!> @details This is intended for use in cloud resolving model simulations in a
!>          Cartesian domain.
module vertadvect_forcing_alg_mod

  use config_mod,                    only: config_type
  use constants_mod,                 only: i_def, r_def, l_def
  use field_mod,                     only: field_type
  use finite_element_config_mod,     only: element_order_h, element_order_v
  use fs_continuity_mod,             only: Wtheta, W3
  use function_space_collection_mod, only: function_space_collection
  use sci_geometric_constants_mod,   only: get_height_fv
  use field_collection_mod,          only: field_collection_type
  use map_fd_to_prognostics_alg_mod, only: set_wind
  use mesh_mod,                      only: mesh_type
  !> @todo Data passed to the kernel via module 'use' statements.
  !>       When PSyclone supports passing of arrays into kernels (issue #1312),
  !>       these data should be passed through the argument list of the invoke.
  use profile_interp_kernel_mod,     only: profile_interp_kernel_type,         &
                                           profile_size,                       &
                                           profile_data,                       &
                                           profile_heights
  use prof_temporal_interp_mod,      only: prof_temporal_interp

  implicit none

  private
  public :: vertadvect_forcing_alg

contains

  !> @brief Calculate advection tendencies arising from a specified vertical
  !>        velocity profile
  !> @details Theta and all moist species are always advected. Exner
  !>          pressure and the cloud fractions are only advected if requested.
  !> @param[in]     config           Application namelist configuration object
  !> @param[in,out] dtheta_forcing   Vertical advection increment to theta
  !> @param[in,out] dmr_forcing      Vertical advection increments to the
  !>                                 moist mixing ratios
  !> @param[in,out] du_forcing       Vertical advection increment to wind
  !> @param[in,out] dexner_forcing   Vertical advection increment to Exner
  !>                                 pressure, giving the Exner pressure at the
  !>                                 departure points (if advect_exner)
  !> @param[in]     advect_exner     Whether to advect Exner pressure
  !> @param[in,out] dcfl_forcing     Vertical advection increment to liquid
  !>                                 cloud fraction (if advect_fractions)
  !> @param[in,out] dcff_forcing     Vertical advection increment to frozen
  !>                                 cloud fraction (if advect_fractions)
  !> @param[in,out] dbcf_forcing     Vertical advection increment to bulk
  !>                                 cloud fraction (if advect_fractions)
  !> @param[in]     advect_fractions Whether to advect the cloud fractions
  !> @param[in]     theta            Field to which vertical advection is applied
  !> @param[in]     mr               Field to which vertical advection is applied
  !> @param[in]     exner_in_wth     Exner pressure in Wtheta space
  !> @param[in]     rho              Dry air density in same space as field
  !> @param[in]     derived_fields   Group of derived fields
  !> @param[in]     cloud_fields     Group of cloud fields
  !> @param[in]     twod_mesh        Information about the horizontal mesh
  !> @param[in]     dt               Timestep
  !> @param[in]     time_now         Current model time in seconds
  subroutine vertadvect_forcing_alg( config,                                    &
                                     dtheta_forcing, dmr_forcing, du_forcing,   &
                                     dexner_forcing, advect_exner,              &
                                     dcfl_forcing, dcff_forcing, dbcf_forcing,  &
                                     advect_fractions,                          &
                                     theta, mr, exner_in_wth, rho,              &
                                     derived_fields, cloud_fields,              &
                                     twod_mesh, dt, time_now )

  use vertadvect_config_mod,   only: number_times, number_heights,             &
                                     times, heights, profile_data_w
  use vertadv_wind_kernel_mod, only: vertadv_wind_kernel_type
  use horiz_mean_alg_mod,      only: horiz_mean_alg
  use mr_indices_mod,          only: nummr

  implicit none

  type(config_type), intent(in) :: config

  type( field_type ), intent(inout)         :: dtheta_forcing,                 &
                                               dmr_forcing(nummr),             &
                                               du_forcing, dexner_forcing,     &
                                               dcfl_forcing, dcff_forcing,     &
                                               dbcf_forcing
  logical( kind=l_def ), intent(in)         :: advect_exner, advect_fractions
  type( field_type ), intent(in)            :: theta, mr(nummr)
  type( field_type ), intent(in)            :: exner_in_wth, rho
  type( field_collection_type ), intent(in) :: derived_fields, cloud_fields
  type( mesh_type ), pointer, intent(in)    :: twod_mesh

  real( kind=r_def ), intent(in)            :: dt, time_now

  integer( kind=i_def )       :: mesh_id, nlayers, i_mr
  logical( kind=l_def )       :: profile_extrap

  type( field_type )          :: du_vertadv
  type( field_type )          :: field_mean
  type( field_type )          :: w_rholev  ! vert adv velocity on rholevs
  type( field_type )          :: w_thlev   ! vert adv velocity on theta levels
  type( mesh_type ),  pointer :: mesh => null()
  real( kind=r_def )          :: w_lsadv_now( number_heights )

  type( field_type ), pointer :: height_wth => null()
  type( field_type ), pointer :: height_w3 => null()
  type( field_type ), pointer :: u_in_w3 => null()
  type( field_type ), pointer :: v_in_w3 => null()
  type( field_type ), pointer :: liquid_fraction
  type( field_type ), pointer :: frozen_fraction
  type( field_type ), pointer :: bulk_fraction

  type( field_type ) :: du_in_w3, dv_in_w3, dw_in_wth

  profile_extrap = .true.
  mesh => theta%get_mesh()
  nlayers = mesh%get_nlayers()

  ! put w_rholev on rho levels, cell-faces for theta,
  ! for standard 1st order upwind
  call w_rholev%initialise      ( vector_space = rho%get_function_space() )

  if ( number_times == 1 ) then
    w_lsadv_now(:) = profile_data_w(:)
  else
    call prof_temporal_interp( time_now, number_heights, number_times, times,  &
                               profile_data_w, w_lsadv_now )
  end if

  ! There's a choice to be made here. Either advect then average, or average
  ! then advect. Choose the latter, replicating what's done in the UM and MONC.
  mesh_id = theta%get_mesh_id()
  height_wth => get_height_fv(config, mesh, Wtheta)

  mesh_id = rho%get_mesh_id()
  height_w3 => get_height_fv(config, mesh, W3)

  ! Advecting vertical velocity on rho levels, used for all Wtheta fields
  if ( number_heights == 1 ) then
    call invoke( setval_c( w_rholev, w_lsadv_now(1) ) )
  else
!> @todo Data passed to the kernel via module 'use' statements.
!>       When PSyclone supports passing of arrays into kernels (issue #1312),
!>       these data should be passed through the argument list of the invoke.
    profile_size                    = number_heights
    profile_data(1:profile_size)    = w_lsadv_now(1:profile_size)
    profile_heights(1:profile_size) = heights(1:profile_size)
    call invoke( profile_interp_kernel_type( w_rholev, height_w3,              &
                                             profile_extrap ) )
  end if

  ! Vertical advection of potential temperature and all the moist species
  ! (vapour, cloud condensate and precipitation)
  call vertadvect_wth_field( dtheta_forcing, theta, w_rholev, height_wth,      &
                             twod_mesh, nlayers, dt )
  do i_mr = 1, nummr
    call vertadvect_wth_field( dmr_forcing(i_mr), mr(i_mr), w_rholev,          &
                               height_wth, twod_mesh, nlayers, dt )
  end do

  ! Vertical advection of Exner pressure, if requested, giving the Exner
  ! pressure at the departure points for the PC2 response to the Lagrangian
  ! pressure change
  if ( advect_exner ) then
    call vertadvect_wth_field( dexner_forcing, exner_in_wth, w_rholev,         &
                               height_wth, twod_mesh, nlayers, dt )
  end if

  ! Vertical advection of the cloud fractions, if requested, so that the
  ! cloud fractions stay consistent with the advected cloud condensate
  if ( advect_fractions ) then
    call cloud_fields%get_field( 'liquid_fraction', liquid_fraction )
    call cloud_fields%get_field( 'frozen_fraction', frozen_fraction )
    call cloud_fields%get_field( 'bulk_fraction', bulk_fraction )
    call vertadvect_wth_field( dcfl_forcing, liquid_fraction, w_rholev,        &
                               height_wth, twod_mesh, nlayers, dt )
    call vertadvect_wth_field( dcff_forcing, frozen_fraction, w_rholev,        &
                               height_wth, twod_mesh, nlayers, dt )
    call vertadvect_wth_field( dbcf_forcing, bulk_fraction, w_rholev,          &
                               height_wth, twod_mesh, nlayers, dt )
  end if

  mesh => du_forcing%get_mesh()

  call field_mean%initialise( vector_space = rho%get_function_space() )
  call w_thlev%initialise( vector_space = theta%get_function_space() )

  ! map physics predictors into required spaces
  call derived_fields%get_field('u_in_w3', u_in_w3)
  call derived_fields%get_field('v_in_w3', v_in_w3)

  call du_in_w3%initialise( vector_space =                                     &
      function_space_collection%get_fs( mesh, element_order_h,                 &
                                        element_order_v, W3 ) )

  call dv_in_w3%initialise( vector_space =                                     &
      function_space_collection%get_fs( mesh, element_order_h,                 &
                                        element_order_v, W3 ) )

  call dw_in_wth%initialise( vector_space =                                    &
      function_space_collection%get_fs( mesh, element_order_h,                 &
                                        element_order_v, Wtheta ) )

  call invoke( setval_c( du_in_w3, 0.0_r_def ),                                &
               setval_c( dv_in_w3, 0.0_r_def ),                                &
               setval_c( dw_in_wth, 0.0_r_def ) )

  call horiz_mean_alg( field_mean, nlayers, twod_mesh, u_in_w3 )
  if ( number_heights == 1 ) then
    call invoke( setval_c( w_thlev, w_lsadv_now(1) ),                          &
                 vertadv_wind_kernel_type( du_in_w3, field_mean, w_thlev,      &
                                           height_w3, dt ) )
  else
    profile_size                    = number_heights
    profile_data(1:profile_size)    = w_lsadv_now(1:profile_size)
    profile_heights(1:profile_size) = heights(1:profile_size)
    call invoke(                                                               &
      profile_interp_kernel_type( w_thlev, height_wth, profile_extrap ),       &
      vertadv_wind_kernel_type( du_in_w3, field_mean, w_thlev, height_w3, dt ) &
                )
  end if

  call horiz_mean_alg( field_mean, nlayers, twod_mesh, v_in_w3 )
  if ( number_heights == 1 ) then
    call invoke( setval_c( w_thlev, w_lsadv_now(1) ),                          &
                 vertadv_wind_kernel_type( dv_in_w3, field_mean, w_thlev,      &
                                           height_w3, dt ) )
  else
    profile_size                    = number_heights
    profile_data(1:profile_size)    = w_lsadv_now(1:profile_size)
    profile_heights(1:profile_size) = heights(1:profile_size)
    call invoke( profile_interp_kernel_type( w_thlev, height_wth,              &
                                             profile_extrap ),                 &
                 vertadv_wind_kernel_type( dv_in_w3, field_mean, w_thlev,      &
                                             height_w3, dt ) )
  end if

  call du_vertadv%initialise( vector_space = du_forcing%get_function_space() )
  call set_wind( config, du_vertadv, du_in_w3, dv_in_w3, dw_in_wth )
  call invoke( inc_X_plus_Y( du_forcing, du_vertadv ) )

  end subroutine vertadvect_forcing_alg

  !> @brief Add the vertical advection increment of a Wtheta field, using the
  !>        horizontal mean of the field, to a forcing increment
  !> @param[in,out] dfield_forcing  Forcing increment to add to
  !> @param[in]     field           Field to which vertical advection is applied
  !> @param[in]     w_rholev        Advecting vertical velocity on rho levels
  !> @param[in]     height_wth      Height of Wtheta levels
  !> @param[in]     twod_mesh       Information about the horizontal mesh
  !> @param[in]     nlayers         Number of model layers
  !> @param[in]     dt              Timestep
  subroutine vertadvect_wth_field( dfield_forcing, field, w_rholev,            &
                                   height_wth, twod_mesh, nlayers, dt )

  use vertadvect_kernel_mod, only: vertadvect_kernel_type
  use horiz_mean_alg_mod,    only: horiz_mean_alg

  implicit none

  type( field_type ), intent(inout)      :: dfield_forcing
  type( field_type ), intent(in)         :: field, w_rholev, height_wth
  type( mesh_type ), pointer, intent(in) :: twod_mesh
  integer( kind=i_def ), intent(in)      :: nlayers
  real( kind=r_def ), intent(in)         :: dt

  type( field_type ) :: field_mean, dfield_vertadv

  call field_mean%initialise( vector_space = field%get_function_space() )
  call dfield_vertadv%initialise( vector_space = field%get_function_space() )

  call horiz_mean_alg( field_mean, nlayers, twod_mesh, field )
  call invoke( vertadvect_kernel_type( dfield_vertadv, field_mean, w_rholev,   &
                                       height_wth, dt ),                       &
               inc_X_plus_Y( dfield_forcing, dfield_vertadv ) )

  end subroutine vertadvect_wth_field
end module vertadvect_forcing_alg_mod

	<field field_ref="microphysics__dbcf_mphys" />
	<field field_ref="microphysics__dcfl_mphys" />
	<field field_ref="processed__total_prec" />
	<field field_ref="cloud__bulk_fraction" />
	<field field_ref="cloud__combined_cloud_amount" />
	<field field_ref="cloud__cloud_amount_maxrnd" />
	<field field_ref="cloud__dt_pc2_initiation" />
	<field field_ref="cloud__dmv_pc2_initiation" />
	<field field_ref="cloud__dmcl_pc2_initiation" />
	<field field_ref="cloud__dbcf_pc2_initiation" />
	<field field_ref="cloud__dcfl_pc2_initiation" />
	<field field_ref="cloud__dt_pc2_checks" />
	<field field_ref="cloud__dmv_pc2_checks" />
	<field field_ref="cloud__dmcl_pc2_checks" />
